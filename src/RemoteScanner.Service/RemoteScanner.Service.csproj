<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RemoteScanner.Service</AssemblyName>
    <RootNamespace>RemoteScanner.Service</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceBase, for the session-change notifications the whole design depends on. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteScanner.Common\RemoteScanner.Common.csproj" />
    <ProjectReference Include="..\RemoteScanner.Rdp\RemoteScanner.Rdp.csproj" />
    <!-- The session-agent role, hosted by this executable rather than shipped as its own. -->
    <ProjectReference Include="..\RemoteScanner.SessionAgent\RemoteScanner.SessionAgent.csproj" />
  </ItemGroup>

</Project>
