<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The virtual channel is driven with ReadFile/WriteFile over a pinned buffer, so the
         payload never has to be copied to hand it to the kernel. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RemoteScanner.Rdp</AssemblyName>
    <RootNamespace>RemoteScanner.Rdp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteScanner.Common\RemoteScanner.Common.csproj" />
    <ProjectReference Include="..\RemoteScanner.Protocol\RemoteScanner.Protocol.csproj" />
  </ItemGroup>

</Project>
