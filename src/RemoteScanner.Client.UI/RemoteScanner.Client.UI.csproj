<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon is the only reliable tray API on Windows; WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RemoteScanner.Client</AssemblyName>
    <RootNamespace>RemoteScanner.Client.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteScanner.Agent\RemoteScanner.Agent.csproj" />
    <ProjectReference Include="..\RemoteScanner.Common\RemoteScanner.Common.csproj" />
    <ProjectReference Include="..\RemoteScanner.Protocol\RemoteScanner.Protocol.csproj" />
    <ProjectReference Include="..\RemoteScanner.Rdp\RemoteScanner.Rdp.csproj" />
  </ItemGroup>

</Project>
