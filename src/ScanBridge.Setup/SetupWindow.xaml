<Window x:Class="ScanBridge.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanBridge Setup"
        Width="580" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="Navy" Color="#214A8C"/>
    <SolidColorBrush x:Key="CardNavy" Color="#0F2545"/>
    <SolidColorBrush x:Key="Teal" Color="#2FD3C7"/>
    <SolidColorBrush x:Key="Muted" Color="#5A6B82"/>
    <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>

    <!-- Buttons. Flat, because the default WPF chrome looks like 2006 and this is the first
         thing anyone sees of the product. -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Foreground" Value="#1B2A41"/>
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Background" Value="{StaticResource Navy}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Navy}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <StackPanel>

    <!-- Header -->
    <Border Background="{StaticResource CardNavy}" Padding="24,20">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TitleText" Text="ScanBridge" Foreground="White"
                     FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="VersionText" Text="" Foreground="#9DB8E0"
                     FontSize="13" Margin="10,12,0,0"/>
        </StackPanel>
        <Rectangle Height="3" Width="52" Fill="{StaticResource Teal}"
                   HorizontalAlignment="Left" Margin="1,9,0,9" RadiusX="1.5" RadiusY="1.5"/>
        <TextBlock x:Name="SummaryText" Foreground="#9DB8E0" TextWrapping="Wrap"
                   Text="Scanner redirection over RDP."/>
      </StackPanel>
    </Border>

    <!-- Already installed -->
    <Border x:Name="ExistingBanner" Background="#F1F5F9" BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1" Padding="24,12" Visibility="Collapsed">
      <TextBlock x:Name="ExistingText" TextWrapping="Wrap" Foreground="#1B2A41"/>
    </Border>

    <!-- Choices -->
    <StackPanel x:Name="ChoicesPanel" Margin="24,20,24,4">

      <TextBlock Text="Install to" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FolderBox" Padding="8,7" BorderBrush="{StaticResource Line}"
                 VerticalContentAlignment="Center"/>
        <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse…" Style="{StaticResource Flat}"
                Click="OnBrowse"/>
      </Grid>

      <CheckBox x:Name="DesktopCheck" Content="Create a desktop shortcut"
                Margin="0,16,0,0" IsChecked="True"/>
      <CheckBox x:Name="StartupCheck" Content="Start automatically when I sign in"
                Margin="0,9,0,0" IsChecked="True"/>

      <TextBlock x:Name="ElevationNote" Margin="0,14,0,0" TextWrapping="Wrap"
                 Foreground="{StaticResource Muted}" Visibility="Collapsed"
                 Text="Installing needs administrator rights. Windows will ask for permission."/>
    </StackPanel>

    <!-- Output -->
    <Border x:Name="LogPanel" Margin="24,14,24,0" Visibility="Collapsed"
            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
      <ScrollViewer x:Name="LogScroller" Height="188" VerticalScrollBarVisibility="Auto" Padding="10,8">
        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                   TextWrapping="Wrap" Foreground="#1B2A41"/>
      </ScrollViewer>
    </Border>

    <!-- Buttons -->
    <Border Margin="0,20,0,0" Padding="24,14" Background="#F8FAFC"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource Flat}"
                  Visibility="Collapsed" Click="OnUninstall"/>
          <Button x:Name="CloseButton" Content="Close" Style="{StaticResource Flat}" Click="OnClose"/>
          <Button x:Name="InstallButton" Content="Install" Style="{StaticResource Primary}"
                  Click="OnInstall" IsDefault="True"/>
        </StackPanel>
      </Grid>
    </Border>

  </StackPanel>
</Window>
