<Window x:Class="ScanBridge.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ScanBridge" Height="640" Width="940" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- Same palette as the setup window and the mark. One product, one set of colours. -->
        <SolidColorBrush x:Key="Navy" Color="#214A8C" />
        <SolidColorBrush x:Key="CardNavy" Color="#0F2545" />
        <SolidColorBrush x:Key="Teal" Color="#2FD3C7" />
        <SolidColorBrush x:Key="Ink" Color="#1B2A41" />
        <SolidColorBrush x:Key="Muted" Color="#5A6B82" />
        <SolidColorBrush x:Key="Line" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Surface" Color="#F8FAFC" />

        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FCFDFE" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        </Style>

        <!-- Column headers: quiet, so the rows are what the eye lands on. -->
        <Style TargetType="{x:Type primitives:DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons, matching the setup window. Flat, rounded, two weights. -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Background" Value="{StaticResource Navy}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Navy}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--
            The scanner the remote session gets is picked out of the list, because which one it
            is matters more than anything else on this screen and was previously only findable
            by reading a column. Teal-tinted while a remote session is actually using it; a calm
            blue when it is merely the one that would be used.

            Selection still wins: the user needs to see what they are about to act on, so a
            selected row keeps the highlight regardless.
        -->
        <Style TargetType="DataGridRow" x:Key="ScannerRowStyle">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter Property="Background" Value="#EAF2FE" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Background" Value="#DFF7F4" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Navy}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header. Same band as the setup window, so the two read as one product. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardNavy}" Padding="22,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ScanBridge" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderVersion" Foreground="#9DB8E0" FontSize="12" Margin="9,9,0,0" />
                </StackPanel>
                <Rectangle Height="3" Width="42" Fill="{StaticResource Teal}" RadiusX="1.5" RadiusY="1.5"
                           HorizontalAlignment="Left" Margin="1,7,0,0" />
            </StackPanel>
        </Border>

        <!-- Status strip -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,10">
            <TextBlock x:Name="StatusText" Text="Starting..." Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!--
            Actions wrap rather than sitting in one row.

            There are nine of them, and in a single StackPanel the last one was clipped off the
            right edge at the default window width - the button was there, drawn, and unreachable.
            A WrapPanel cannot do that at any width.
        -->
        <Border DockPanel.Dock="Bottom" Padding="22,14,22,6" Background="White"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <WrapPanel>
                <Button x:Name="UseForRemoteButton" Content="Use for Remote" Click="OnUseForRemote"
                        Style="{StaticResource Primary}" MinWidth="128"
                        ToolTip="Give this scanner to applications running in the Remote Desktop session." />
                <Button x:Name="ScanButton" Content="Test Scan" Click="OnTestScan"
                        Style="{StaticResource Flat}"
                        ToolTip="Scan one page here, locally, to check the scanner itself works." />
                <Button x:Name="ViewScanButton" Content="View Scan" Click="OnViewScan" IsEnabled="False"
                        Style="{StaticResource Flat}"
                        ToolTip="Open the last test scan. Counting bytes says the scan happened; looking at it says the image is right." />
                <Button x:Name="SettingsButton" Content="Scanner Settings" Click="OnSettings"
                        Style="{StaticResource Flat}" MinWidth="128" />
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh"
                        Style="{StaticResource Flat}" />
                <Button x:Name="TestButton" Content="Test Connection" Click="OnTestConnection"
                        Style="{StaticResource Flat}" MinWidth="128" />
                <Button x:Name="PairingButton" Content="Pairing Code" Click="OnPairingCode"
                        Style="{StaticResource Flat}"
                        ToolTip="Needed only if scanning over Remote Desktop does not work by itself." />
                <Button x:Name="DiagnosticsButton" Content="Diagnostics" Click="OnDiagnostics"
                        Style="{StaticResource Flat}" />
                <Button x:Name="LogsButton" Content="Logs" Click="OnOpenLogs"
                        Style="{StaticResource Flat}" />
            </WrapPanel>
        </Border>

        <Grid Margin="22,18,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="130" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.4*" MinHeight="150" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Heading}"
                       Text="Remote Desktop connections using this scanner" />

            <Grid Grid.Row="1">
                <DataGrid x:Name="SessionsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Link" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="From" Binding="{Binding PeerName}" Width="*" />
                        <DataGridTextColumn Header="Connected at" Binding="{Binding Connected}" Width="150" />
                        <DataGridTextColumn Header="Up for" Binding="{Binding Age}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state, drawn over the grid rather than instead of it, so the columns
                     stay visible and the panel does not jump when the first session arrives. -->
                <Border x:Name="NoLinksHint" Background="#FBFCFE" Margin="1,39,1,1"
                        IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No Remote Desktop connection is using this scanner yet."
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Connect with Remote Desktop Connection (mstsc) and this fills in."
                                   Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,2" Text="Detected scanners" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,7"
                           Text="Select one and choose &quot;Use for Remote&quot; to decide which scanner the Remote Desktop session gets." />
            </StackPanel>

            <DataGrid Grid.Row="3" x:Name="ScannersGrid" RowStyle="{StaticResource ScannerRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Used remotely" Binding="{Binding RemoteUse}" Width="130" />
                    <DataGridTextColumn Header="Remote activity" Binding="{Binding RemoteActivity}" Width="115" />
                    <DataGridTextColumn Header="Scanner" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </DockPanel>
</Window>
