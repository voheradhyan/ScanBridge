<Window x:Class="ScanBridge.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanBridge" Height="660" Width="900" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!--
        Designed around the one question anyone opens this for: is my scanner working in my
        remote session? The previous layout answered it nowhere - two tables of equal weight and
        a status bar, leaving the user to infer the answer from what was absent. So:

          - the state of the whole system is a sentence at the top, in the place people look
            first, with the bridge drawn beside it so the arrangement is concrete rather than
            something to be deduced from the word "link"
          - the scanner the remote session gets is chosen by a radio button on the scanner
            itself, not by selecting a row and then finding a button. Direct manipulation
            removes the "did that work?" pause between the two
          - nine equal buttons became two, plus a menu. Five of those were troubleshooting tools
            that belong out of the way on a good day, and putting "Pairing Code" beside "Test
            Scan" implied they were comparable things to do
          - empty states say what to do next, in the place the thing is missing from, instead of
            being announced twice in two different registers
    -->

    <Window.Resources>

        <SolidColorBrush x:Key="Navy" Color="#214A8C" />
        <SolidColorBrush x:Key="CardNavy" Color="#0F2545" />
        <SolidColorBrush x:Key="Teal" Color="#2FD3C7" />
        <SolidColorBrush x:Key="TealInk" Color="#0E7C74" />
        <SolidColorBrush x:Key="Amber" Color="#B4690E" />
        <SolidColorBrush x:Key="Ink" Color="#1B2A41" />
        <SolidColorBrush x:Key="Muted" Color="#5A6B82" />
        <SolidColorBrush x:Key="Faint" Color="#8A9BB0" />
        <SolidColorBrush x:Key="Line" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Card" Color="#FFFFFF" />

        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CFD8E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Background" Value="{StaticResource Navy}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Navy}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="19,8" />
        </Style>

        <!-- A card. Used for both lists, so a scanner and a connection feel like the same
             kind of object rather than two different table technologies. -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="shell" CornerRadius="8" Background="{StaticResource Card}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="BorderBrush" Value="#B9C6D6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource Navy}" />
                                <Setter TargetName="shell" Property="Background" Value="#F5F9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ============================ STATE, not branding ============================ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardNavy}" Padding="22,16,22,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The mark, at a size worth having. At 18px it was a smudge doing neither job:
                     too small to be recognised, large enough to take space. -->
                <Image x:Name="HeaderLogo" Grid.Column="0" Width="64" Height="64"
                       VerticalAlignment="Center" Margin="0,0,20,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!--
                    The name and the state bracket the mark: first line pinned to the top of a
                    block exactly as tall as the logo, second pinned to its bottom, both aligned
                    to the logo's top edge. The pair reads as one object with the mark rather
                    than as text that happens to sit near it.

                    The dot is inline at the start of the second line, so it falls directly under
                    the S of ScanBridge. It spent one revision in a gutter of its own, which put
                    every line on a single left edge and looked tidy in isolation - and left the
                    dot lined up with nothing.
                -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Height="64">
                        <TextBlock VerticalAlignment="Top">
                            <Run Text="ScanBridge" Foreground="#8FA9D4" FontSize="14"
                                 FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="HeaderVersion"
                                 Foreground="#5A73A0" FontSize="12.5" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Ellipse x:Name="HeroDot" Width="10" Height="10"
                                     Fill="{StaticResource Teal}" VerticalAlignment="Center"
                                     Margin="0,2,11,0" />
                            <TextBlock x:Name="HeroHeadline" Text="Starting…" Foreground="White"
                                       FontSize="24" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Outside the bracketed pair: a third line cannot fit between the logo's
                         top and bottom without crushing the other two, and this one is often
                         empty. The header grows when there is something to say. -->
                    <TextBlock x:Name="StatusText" Text="" Foreground="#9DB8E0" Margin="21,7,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- The bridge. The product is a span between two machines and nothing on the
                     old screen showed that; this makes the mental model visible and doubles as
                     the connection indicator.

                     Each end is a drawn machine rather than a labelled rectangle. Two boxes
                     containing words are two boxes; a laptop and a monitor are the two places,
                     and which is which is legible before the labels are read. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="24,0,0,0">

                    <StackPanel Width="98">
                        <Border Width="78" Height="56" CornerRadius="8" Background="#1B3A66"
                                BorderBrush="#2E5488" BorderThickness="1">
                            <!-- Laptop: this PC, the one the scanner is plugged into. -->
                            <Canvas Width="30" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="#BFD3EE" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M3,3 H27 V17 H3 Z" />
                                <Path Fill="#BFD3EE" Data="M0.5,19.5 H29.5 L28,22.5 H2 Z" />
                                <Line X1="8" Y1="8" X2="22" Y2="8" Stroke="#2FD3C7" StrokeThickness="1.7" />
                            </Canvas>
                        </Border>
                        <TextBlock Text="This PC" Foreground="#BFD3EE" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock x:Name="BridgeScannerName" Text="" Foreground="#7E97C4" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="98" />
                    </StackPanel>

                    <Canvas Width="52" Height="52" VerticalAlignment="Top">
                        <Line x:Name="BridgeLine" X1="2" Y1="26" X2="50" Y2="26"
                              Stroke="#2E5488" StrokeThickness="2" StrokeDashArray="3 3" />
                        <Ellipse x:Name="BridgePulse" Canvas.Left="21" Canvas.Top="21" Width="10" Height="10"
                                 Fill="{StaticResource Teal}" Visibility="Collapsed" />
                    </Canvas>

                    <StackPanel Width="98">
                        <Border x:Name="BridgeRemoteBox" Width="78" Height="56" CornerRadius="8"
                                Background="#152F52" BorderBrush="#2E5488" BorderThickness="1">
                            <!-- Monitor on a stand: the session on the server. Deliberately a
                                 different silhouette from the laptop, so the two ends are told
                                 apart by shape and not only by the words underneath. -->
                            <Canvas x:Name="BridgeRemoteIcon" Width="30" Height="24"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="BridgeRemoteScreen" Stroke="#6E86B2" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" Data="M3,3 H27 V17 H3 Z" />
                                <Path x:Name="BridgeRemoteStand" Fill="#6E86B2"
                                      Data="M13,17 H17 V20.5 H22 V22.5 H8 V20.5 H13 Z" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="BridgeRemoteText" Text="Remote session" Foreground="#6E86B2"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock x:Name="BridgeRemoteName" Text="" Foreground="#7E97C4" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="98" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Actions ============================ -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" Padding="22,13"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
                <Button x:Name="ScanButton" Click="OnTestScan" Style="{StaticResource Primary}"
                        HorizontalAlignment="Left"
                        ToolTip="Scan one page here, locally. No Remote Desktop involved, so a failure here means the scanner or its driver.">
                    <StackPanel Orientation="Horizontal">
                        <!-- A page with a scan line across it. Drawn rather than set in a font,
                             because a glyph that is missing renders as a box and there is no
                             warning when that happens on somebody else's machine. -->
                        <Canvas Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Path Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Data="M3,1.5 H12 V13.5 H3 Z" />
                            <Line X1="1" Y1="7.5" X2="14" Y2="7.5" Stroke="#2FD3C7" StrokeThickness="1.8" />
                        </Canvas>
                        <TextBlock Text="Test scan" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Click="OnRefresh" Style="{StaticResource Flat}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path Stroke="#1B2A41" StrokeThickness="1.5" Fill="Transparent"
                                      Data="M13,7.5 A5.5,5.5 0 1 1 11,3.3" />
                                <Path Fill="#1B2A41" Data="M13.6,0.8 L13.6,4.4 L10,4.4 Z" />
                            </Canvas>
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="MoreButton" Click="OnMore" Style="{StaticResource Flat}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse Canvas.Left="4.5" Canvas.Top="4.5" Width="6" Height="6"
                                         Stroke="#1B2A41" StrokeThickness="1.5" />
                                <Line X1="7.5" Y1="0.5" X2="7.5" Y2="3" Stroke="#1B2A41" StrokeThickness="1.5" />
                                <Line X1="7.5" Y1="12" X2="7.5" Y2="14.5" Stroke="#1B2A41" StrokeThickness="1.5" />
                                <Line X1="0.5" Y1="7.5" X2="3" Y2="7.5" Stroke="#1B2A41" StrokeThickness="1.5" />
                                <Line X1="12" Y1="7.5" X2="14.5" Y2="7.5" Stroke="#1B2A41" StrokeThickness="1.5" />
                            </Canvas>
                            <TextBlock Text="Troubleshooting" VerticalAlignment="Center" />
                            <!-- A drawn triangle. The chevron character sat off the baseline and
                                 rendered at a different weight to the label beside it. -->
                            <Path Data="M0,0 L8,0 L4,4.5 Z" Fill="#5A6B82" VerticalAlignment="Center"
                                  Margin="9,2,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu" Placement="Top">
                                <MenuItem x:Name="SettingsButton" Header="Scanner settings…" Click="OnSettings" />
                                <MenuItem x:Name="TestButton" Header="Test connection to the agent" Click="OnTestConnection" />
                                <Separator />
                                <MenuItem x:Name="PairingButton" Header="Pairing code…" Click="OnPairingCode"
                                          ToolTip="Only needed when the Remote Desktop channel cannot carry data." />
                                <MenuItem x:Name="DiagnosticsButton" Header="Diagnostics report…" Click="OnDiagnostics" />
                                <MenuItem x:Name="LogsButton" Header="Open logs folder" Click="OnOpenLogs" />
                                <Separator />
                                <MenuItem x:Name="AboutItem" IsEnabled="False" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Content ============================ -->
        <Grid Margin="22,18,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SectionLabel}" Text="REMOTE DESKTOP CONNECTIONS" />

            <Grid Grid.Row="1" MinHeight="64" Margin="0,0,0,20">
                <ListBox x:Name="SessionsGrid" Style="{StaticResource CardList}" MaxHeight="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="8" Height="8" Fill="#2FD3C7" VerticalAlignment="Center"
                                         Margin="2,0,12,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding PeerName}" FontWeight="SemiBold"
                                               Foreground="#1B2A41" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="#5A6B82" FontSize="12" Margin="0,2,0,0">
                                        <Run Text="Connected" /><Run Text=" " /><Run Text="{Binding Connected, Mode=OneWay}" />
                                        <Run Text=" · up for " /><Run Text="{Binding Age, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="10" Background="#E6FAF8" Padding="9,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Live" Foreground="#0E7C74" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state: says what to do, where the thing is missing from. -->
                <Border x:Name="NoLinksHint" CornerRadius="8" Background="#FFFFFF"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Nothing is using this scanner remotely yet."
                                   Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Text="Connect with Remote Desktop Connection (mstsc.exe) and this fills in. Add-ins load when the session connects, so reconnect after installing." />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource SectionLabel}" Margin="2,0,0,3" Text="SCANNERS ON THIS PC" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,9"
                           Text="The one marked below is what applications in your Remote Desktop session are given." />
            </StackPanel>

            <Grid Grid.Row="3">
                <ListBox x:Name="ScannersGrid" Style="{StaticResource CardList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Choosing is the action. No select-a-row-then-press-a-button
                                     round trip, and no doubt about whether the press took. -->
                                <RadioButton GroupName="Redirect" IsChecked="{Binding IsDefault, Mode=OneWay}"
                                             Click="OnRedirectChosen" Tag="{Binding}"
                                             VerticalAlignment="Center" Margin="0,0,13,0"
                                             ToolTip="Give this scanner to applications in the Remote Desktop session." />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="#1B2A41" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#5A6B82" FontSize="12"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"
                                        Background="{Binding ActivityBackground}"
                                        Visibility="{Binding ActivityVisibility}">
                                    <TextBlock Text="{Binding ActivityBadge}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding ActivityForeground}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="NoScannersHint" CornerRadius="8" Background="#FFFDF7"
                        BorderBrush="#F0DCB4" BorderThickness="1" Padding="16,14"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="No scanner found on this PC." Foreground="{StaticResource Amber}"
                                   FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"
                                   TextWrapping="Wrap"
                                   Text="Check it is switched on and connected, and that the maker's driver is installed. A wireless scanner that is asleep will not appear." />
                        <Button Content="Look again" Click="OnRefresh" Style="{StaticResource Flat}"
                                HorizontalAlignment="Left" Margin="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
