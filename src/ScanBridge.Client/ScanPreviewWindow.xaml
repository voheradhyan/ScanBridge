<Window x:Class="ScanBridge.Client.ScanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test scan" Height="760" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!--
        The scanned page, held in memory and never written anywhere.

        An earlier version saved it beside the logs so it could be opened with the shell. That
        was the wrong trade: this is somebody's document, and a diagnostic feature has no
        business leaving one on disk where the next person to use the PC can find it. The bytes
        live in this window, and go when it closes.
    -->

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F2545" Padding="18,13">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Test scan" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="Detail" Foreground="#9DB8E0" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        CornerRadius="10" Background="#173A63" Padding="10,4">
                    <TextBlock Text="Not saved to disk" Foreground="#9DB8E0" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" Padding="18,12"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="#5A6B82" FontSize="12"
                           Text="Closing this window discards the image." />
                <Button Content="Close" Click="OnClose" HorizontalAlignment="Right"
                        IsDefault="True" IsCancel="True" Padding="19,8" Cursor="Hand"
                        Background="#214A8C" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Border Margin="18" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Padding="10">
                <Image x:Name="Page" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
