<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon is the only reliable tray API on Windows; WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ScanBridge.Client</AssemblyName>
    <RootNamespace>ScanBridge.Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- What this executable carries and lays down when it installs itself.

       The RDP add-in must be a DLL, because it is loaded inside mstsc.exe, and mstsc.exe picks
       the bitness — so both are carried. The 32-bit scan host must be its own program, because
       a scanner driver's bitness decides the bitness of the process that can load it; the
       64-bit host is a role of this application and needs no file.

       Each is conditional so a plain "dotnet build" still compiles when the native build or the
       host publish has not run; EmbeddedPayload then names precisely what is missing. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\build\x64\ScanBridge.DvcPlugin.dll"
                      Condition="Exists('..\..\build\x64\ScanBridge.DvcPlugin.dll')"
                      LogicalName="ScanBridge.Payload.x64/ScanBridge.DvcPlugin.dll" />
    <EmbeddedResource Include="..\..\build\x86\ScanBridge.DvcPlugin.dll"
                      Condition="Exists('..\..\build\x86\ScanBridge.DvcPlugin.dll')"
                      LogicalName="ScanBridge.Payload.x86/ScanBridge.DvcPlugin.dll" />
    <EmbeddedResource Include="..\..\build\payload\x86\ScanBridge.ScanHost.exe"
                      Condition="Exists('..\..\build\payload\x86\ScanBridge.ScanHost.exe')"
                      LogicalName="ScanBridge.Payload.x86/ScanBridge.ScanHost.exe" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScanBridge.Agent\ScanBridge.Agent.csproj" />
    <ProjectReference Include="..\ScanBridge.Common\ScanBridge.Common.csproj" />
    <ProjectReference Include="..\ScanBridge.Protocol\ScanBridge.Protocol.csproj" />
    <ProjectReference Include="..\ScanBridge.Rdp\ScanBridge.Rdp.csproj" />
    <!-- The 64-bit scan host runs as a role of this application; see App.OnStartup. -->
    <ProjectReference Include="..\ScanBridge.ScanHost\ScanBridge.ScanHost.csproj" />
  </ItemGroup>

</Project>
