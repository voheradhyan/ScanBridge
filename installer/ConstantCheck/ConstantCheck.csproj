<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside RemoteScanner.sln: this is a build gate, not a component, and
       nothing ships it. Build-All.ps1 runs it through "dotnet run". -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RemoteScanner.ConstantCheck</AssemblyName>
    <RootNamespace>RemoteScanner.ConstantCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

</Project>
